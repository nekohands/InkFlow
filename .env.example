# Copy this file to .env and replace local values as needed.
# Keep .env local only. Never commit passwords, tokens, cookies, or production credentials.
# Local validation scripts load the repository-root .env automatically; exported
# environment variables take precedence. Set INKFLOW_SKIP_LOCAL_ENV=1 to skip.

# Docker Compose selection. Daily development/runtime validation uses the source-built stack.
COMPOSE_FILE=docker-compose.build.yml
INKFLOW_SOURCE_COMPOSE_FILE=docker-compose.build.yml
INKFLOW_RELEASE_COMPOSE_FILE=docker-compose.yml

# Local smoke-test defaults.
INKFLOW_FRONTEND_SMOKE_BASE_URL=http://localhost:8080
INKFLOW_FRONTEND_SMOKE_CURL_MAX_TIME=10
INKFLOW_SLO_SMOKE_BASE_URL=http://localhost:8080
INKFLOW_SLO_PROBE_COUNT=5
INKFLOW_SLO_CURL_MAX_TIME=10

# Compose/observability settings.
INKFLOW_OTEL_METRICS_DEBUG_VERBOSITY=basic
INKFLOW_DB_PASSWORD=change-me-local-only
INKFLOW_PACKAGES_RETENTION_DAYS=7
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_METRIC_EXPORT_INTERVAL=60000

# Optional local publishing/deployment notes. Do not put registry tokens here.
INKFLOW_GHCR_REGISTRY=ghcr.io
INKFLOW_GHCR_NAMESPACE=your-org/your-repo
INKFLOW_VM_HOST=
INKFLOW_VM_USER=
INKFLOW_VM_PASSWORD=
