# syntax=docker/dockerfile:1

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
RUN --mount=type=cache,id=inkflow-nuget,target=/root/.nuget/packages,sharing=locked \
    --mount=type=cache,id=inkflow-nuget-http,target=/root/.local/share/NuGet/v3-cache,sharing=locked \
    dotnet publish src/Apps/InkFlow.Migrations/InkFlow.Migrations.csproj -c Release -o /app/publish --no-self-contained

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
# 基础镜像快照的 libssl3t64 滞后于 Ubuntu 安全 pocket（CVE-2026-84782，
# 修复版 3.0.13-0ubuntu3.16），显式升级，避免发布镜像带已知 HIGH 漏洞。
RUN apt-get update && apt-get install -y --no-install-recommends libssl3t64 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app/publish .
USER app
ENTRYPOINT ["dotnet", "InkFlow.Migrations.dll"]
