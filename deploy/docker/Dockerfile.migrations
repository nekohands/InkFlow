# syntax=docker/dockerfile:1

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
RUN --mount=type=cache,id=inkflow-nuget,target=/root/.nuget/packages,sharing=locked \
    --mount=type=cache,id=inkflow-nuget-http,target=/root/.local/share/NuGet/v3-cache,sharing=locked \
    dotnet publish src/Apps/InkFlow.Migrations/InkFlow.Migrations.csproj -c Release -o /app/publish --no-self-contained

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app
COPY --from=build /app/publish .
USER app
ENTRYPOINT ["dotnet", "InkFlow.Migrations.dll"]
