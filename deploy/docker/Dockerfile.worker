# syntax=docker/dockerfile:1

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
RUN --mount=type=cache,id=inkflow-nuget,target=/root/.nuget/packages,sharing=locked \
    --mount=type=cache,id=inkflow-nuget-http,target=/root/.local/share/NuGet/v3-cache,sharing=locked \
    dotnet publish src/Apps/InkFlow.Worker/InkFlow.Worker.csproj -c Release -o /app/publish --no-self-contained

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app/publish .
ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080
USER app
ENTRYPOINT ["dotnet", "InkFlow.Worker.dll"]
